<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.Label?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<VBox alignment="TOP_CENTER" spacing="10" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.HelloController" stylesheets="@styles.css">

    <Label fx:id="messageLabel" text="Hello, JavaFX!" />
    <ListView fx:id="messageView" VBox.vgrow="ALWAYS"/>
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <TextField fx:id="messageInput" HBox.hgrow="ALWAYS"/>
        <Button text="Send message" onAction="#sendMessage"/>
        <Button text="Attach File" onAction="#attachFile"/>
    </HBox>
</VBox>
